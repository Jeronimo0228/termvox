# Copy to ~/.config/termvox/termvox.toml (global) or ./termvox.toml (project).
# STT guide: docs/performance.md · docs/es/stt.md

performance_profile = "balanced"   # fast | balanced | accurate | custom
speech_engine = "whisper"
agent = "opencode"
# agent_plugin = "example"
push_to_talk = "SPACE"
language = "es"
auto_send = false
confirmation = true
permission_profile = "safe"

[audio]
sample_rate = 16000
max_seconds = 60
vad_threshold_db = -42.0
vad_silence_ms = 700
auto_stop_on_silence = true

[runtime]
agent_timeout_seconds = 900
speech_timeout_seconds = 180
shutdown_timeout_seconds = 5
max_output_bytes = 8388608
max_json_frame_bytes = 1048576

[whisper]
# Install: termvox models install accurate
model = "/home/you/.local/share/termvox/models/ggml-base.bin"
threads = 0
max_threads = 6
prewarm_on_start = true
optimize_for_latency = false
streaming = true

[cursor]
# Deprecated: use [agents.cursor]. Kept for backward-compatible loading.
trust_workspace = false

[agents.cursor]
# display = "shell"
# trust_workspace = true

[agents.opencode]
# display = "shell"

[shell]
hotkey = "F8"
alt_hotkeys = ["Ctrl+Space"]
exit_hotkey = "Ctrl+\\"
auto_submit = true

[workspace]
persist_session = true
discover_session = true

[pipeline]
dictionary = { "api rest" = "REST API", "open code" = "OpenCode" }

[openai]
api_key_env = "OPENAI_API_KEY"
model = "gpt-4o-mini-transcribe"
endpoint = "https://api.openai.com/v1/audio/transcriptions"
timeout_seconds = 180
max_response_bytes = 2097152

[telemetry]
enabled = false
